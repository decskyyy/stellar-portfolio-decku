# Supabase — ambil dari Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Opsional: kunci /admin hanya untuk email ini (kosongkan kalau tidak perlu)
# PENTING: ADMIN_EMAIL adalah SERVER-ONLY variable (bukan NEXT_PUBLIC)
# agar tidak terkirim ke browser client.
ADMIN_EMAIL=admin@example.com
